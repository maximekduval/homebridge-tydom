{
  "name": "homebridge-tydom-mk",
  "displayName": "Homebridge Tydom MK",
  "version": "1.1.0",
  "description": "Homebridge plugin for Tydom devices by Delta Dore (Tyxal, Tyxia...). Fork of mgcrea/homebridge-tydom: https://github.com/maximekduval/homebridge-tydom",
  "author": "maximekduval <maximekduval@gmail.com>",
  "contributors": [
    "Olivier Louvignes <olivier@mgcrea.io>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximekduval/homebridge-tydom.git"
  },
  "homepage": "https://github.com/maximekduval/homebridge-tydom#readme",
  "bugs": {
    "url": "https://github.com/maximekduval/homebridge-tydom/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "tydom",
    "delta-dore",
    "tyxal",
    "tyxia",
    "domotics",
    "home-automation"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "format": "oxfmt --write src/ test/ scripts/",
    "format:check": "oxfmt --check src/ test/ scripts/",
    "check": "tsc --noEmit",
    "spec": "vitest --run",
    "coverage": "vitest --run --coverage",
    "watch": "vitest",
    "hash": "tsx scripts/hash.ts",
    "resolve-credentials": "tsx scripts/resolve-credentials.ts",
    "validate:dumps": "tsx scripts/validate-dumps.ts",
    "build:fixtures": "tsx scripts/build-fixtures.ts",
    "dev:homebridge": "homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "dev:homebridge:insecure": "NODE_TLS_REJECT_UNAUTHORIZED=0 homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "clean": "rm -rf .homebridge/persist/* .homebridge/accessories/*",
    "test": "npm run lint && npm run check && npm run spec && npm run format:check",
    "prepack": "npm test && npm run build"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "kolorist": "^1.8.0",
    "tydom-client": "^0.16.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/debug": "^4.1.13",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.12",
    "homebridge": "^2.5.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": true
  }
}
